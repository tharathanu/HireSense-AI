# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon gives you this)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Long random string used to sign login tokens
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Port for local development
PORT=5000

# Frontend URL(s) allowed to call the API, comma separated
CLIENT_URL="http://localhost:5173"

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="HireSense Admin"

# ---------- Free AI (optional, but recommended) ----------
# Google Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# Groq free key (backup): https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ---------- Email (optional) ----------
# Works with any SMTP service, e.g. Gmail with an App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="HireSense AI <your-email@gmail.com>"

# ---------- GitHub (optional) ----------
# Raises the GitHub API limit for resume authenticity checks
GITHUB_TOKEN=""
