# Backend API address. Locally this is the Express server.
# On Vercel, set this to your Render URL, e.g. https://hiresense-api.onrender.com
VITE_API_URL=http://localhost:5000

# Optional TURN server for group discussions on strict networks (e.g. a free
# Metered.ca or ExpressTURN account). Without it, most home and college Wi-Fi
# networks still connect using Google's free STUN servers.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
